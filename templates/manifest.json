[
  {
    "src": "workload/data",
    "dest": "data",
    "render": false,
    "scope": "workload"
  },
  {
    "src": "workload/src",
    "dest": "src",
    "scope": "workload"
  },
  {
    "src": "workload/tests",
    "dest": "tests",
    "scope": "workload"
  },
  {
    "src": "workload/azureml",
    "dest": "mlops/azureml",
    "scope": "workload"
  },
  {
    "src": "workload/adls",
    "dest": "mlops/azureml",
    "when": {
      "data_source": "adls"
    },
    "scope": "workload"
  },
  {
    "src": "workload/online",
    "dest": "mlops/azureml",
    "when": {
      "endpoint_online": "true"
    },
    "scope": "workload"
  },
  {
    "src": "workload/batch",
    "dest": "mlops/azureml",
    "when": {
      "endpoint_batch": "true"
    },
    "scope": "workload"
  },
  {
    "src": "root",
    "dest": "."
  },
  {
    "src": "iac/terraform",
    "dest": "infra",
    "when": {
      "iac": "terraform"
    }
  },
  {
    "src": "iac/bicep",
    "dest": "infra",
    "when": {
      "iac": "bicep"
    }
  },
  {
    "src": "cicd/github/common",
    "dest": ".github/workflows",
    "when": {
      "cicd": "github"
    },
    "scope": "workload",
    "suffix_files": true
  },
  {
    "src": "cicd/github/terraform",
    "dest": ".github/workflows",
    "when": {
      "cicd": "github",
      "iac": "terraform"
    }
  },
  {
    "src": "cicd/github/bicep",
    "dest": ".github/workflows",
    "when": {
      "cicd": "github",
      "iac": "bicep"
    }
  },
  {
    "src": "cicd/github/deploy-online",
    "dest": ".github/workflows",
    "when": {
      "cicd": "github",
      "deploy_mode": "online"
    },
    "scope": "workload",
    "suffix_files": true
  },
  {
    "src": "cicd/github/deploy-bluegreen",
    "dest": ".github/workflows",
    "when": {
      "cicd": "github",
      "deploy_mode": "bluegreen"
    },
    "scope": "workload",
    "suffix_files": true
  },
  {
    "src": "cicd/github/deploy-batch",
    "dest": ".github/workflows",
    "when": {
      "cicd": "github",
      "deploy_mode": "batch"
    },
    "scope": "workload",
    "suffix_files": true
  },
  {
    "src": "cicd/github/registry",
    "dest": ".github/workflows",
    "when": {
      "cicd": "github",
      "registry": "true"
    },
    "scope": "workload",
    "suffix_files": true
  },
  {
    "src": "cicd/azdo/common",
    "dest": "pipelines",
    "when": {
      "cicd": "azdo"
    },
    "scope": "workload",
    "suffix_files": true
  },
  {
    "src": "cicd/azdo/terraform",
    "dest": "pipelines",
    "when": {
      "cicd": "azdo",
      "iac": "terraform"
    }
  },
  {
    "src": "cicd/azdo/bicep",
    "dest": "pipelines",
    "when": {
      "cicd": "azdo",
      "iac": "bicep"
    }
  },
  {
    "src": "cicd/azdo/deploy-online",
    "dest": "pipelines",
    "when": {
      "cicd": "azdo",
      "deploy_mode": "online"
    },
    "scope": "workload",
    "suffix_files": true
  },
  {
    "src": "cicd/azdo/deploy-bluegreen",
    "dest": "pipelines",
    "when": {
      "cicd": "azdo",
      "deploy_mode": "bluegreen"
    },
    "scope": "workload",
    "suffix_files": true
  },
  {
    "src": "cicd/azdo/deploy-batch",
    "dest": "pipelines",
    "when": {
      "cicd": "azdo",
      "deploy_mode": "batch"
    },
    "scope": "workload",
    "suffix_files": true
  },
  {
    "src": "cicd/azdo/registry",
    "dest": "pipelines",
    "when": {
      "cicd": "azdo",
      "registry": "true"
    },
    "scope": "workload",
    "suffix_files": true
  },
  {
    "src": "bootstrap/github",
    "dest": "bootstrap",
    "when": {
      "cicd": "github"
    }
  },
  {
    "src": "bootstrap/azdo",
    "dest": "bootstrap",
    "when": {
      "cicd": "azdo"
    }
  }
]
