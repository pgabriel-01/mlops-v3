{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MLOps v3 accelerator inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_name",
    "location",
    "subscription_id",
    "tenant_id",
    "iac",
    "cicd",
    "scenario"
  ],
  "properties": {
    "project_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,9}$",
      "description": "3-10 lowercase alphanumerics; used in CAF-style resource names (storage account limit is 24 chars)."
    },
    "location": {
      "type": "string",
      "pattern": "^[a-z0-9]+$",
      "description": "Azure region, for example eastus2."
    },
    "subscription_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
    },
    "iac": {
      "type": "string",
      "enum": [
        "terraform",
        "bicep"
      ]
    },
    "cicd": {
      "type": "string",
      "enum": [
        "github",
        "azdo"
      ]
    },
    "scenario": {
      "type": "string",
      "enum": [
        "basic-public",
        "managed-vnet-internet",
        "managed-vnet-approved",
        "byo-vnet",
        "batch-scoring",
        "online-bluegreen",
        "feature-store",
        "registry-promotion",
        "governance",
        "genai-foundry",
        "existing-platform",
        "rag-llmops"
      ],
      "description": "Azure Machine Learning platform scenario (see Get-MLOpsScenario)."
    },
    "data_source": {
      "type": "string",
      "enum": [
        "taxi-csv",
        "taxi-parquet",
        "adls"
      ],
      "default": "taxi-csv",
      "description": "taxi-csv and taxi-parquet use the bundled NYC taxi sample (derived from the MIT-licensed azureml-examples repository, see data/NOTICE.md in the generated project), registered as an MLTable data asset. adls reads a CSV from an ADLS Gen2 container through an identity-based Azure Machine Learning datastore. Other sources are not generated; land the data in ADLS first (see docs/planning/data-sources.md)."
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "dev",
          "test",
          "prod"
        ]
      },
      "default": [
        "dev",
        "test",
        "prod"
      ]
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "github_org": {
      "type": "string",
      "minLength": 1
    },
    "github_repo": {
      "type": "string",
      "minLength": 1
    },
    "azdo_org_url": {
      "type": "string",
      "pattern": "^https://dev\\.azure\\.com/[^/]+/?$"
    },
    "azdo_project": {
      "type": "string",
      "minLength": 1
    },
    "workload_type": {
      "type": "string",
      "enum": [
        "tabular"
      ],
      "default": "tabular",
      "description": "The kind of machine learning workload pack to generate. Only tabular exists today. Not to be confused with workloads, the list of workload names that share one platform."
    },
    "vnet_address_space": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+/\\d+$",
      "default": "10.20.0.0/16",
      "description": "byo-vnet: address space of the created spoke VNet."
    },
    "allowed_outbound_fqdns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "pypi.org",
        "files.pythonhosted.org",
        "*.anaconda.com",
        "conda.anaconda.org"
      ],
      "description": "managed-vnet-approved: FQDN allow-list."
    },
    "policy_mode": {
      "type": "string",
      "enum": ["audit", "deny", "none"],
      "description": "Built-in Azure Policy guardrails on each environment resource group. Default: audit (none for the existing-platform scenario)."
    },
    "compute_vm_size": {
      "type": "string",
      "pattern": "^Standard_[A-Za-z0-9_]+$",
      "default": "Standard_DS3_v2",
      "description": "VM size for the training cluster (cpu-cluster) and the online endpoint deployment. Check quota in your region first."
    },
    "compute_max_nodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 4,
      "description": "Maximum nodes the training cluster scales out to (minimum is always 0)."
    },
    "name_suffix": {
      "type": "string",
      "pattern": "^[a-z0-9]{5}$",
      "description": "Optional override for the unique 5-character resource name suffix (default: derived from subscription and project). Change it to redeploy after a destroy, because soft-deleted Key Vaults and workspaces keep their names reserved."
    },
    "keyvault_retention_days": {
      "type": "integer",
      "minimum": 7,
      "maximum": 90,
      "default": 7,
      "description": "Key Vault soft-delete retention in days. Fixed at creation. Purge protection stays on, so a destroyed vault name is reserved for this long."
    },
    "budget_amount": {
      "type": "number",
      "minimum": 1,
      "default": 500,
      "description": "governance: monthly budget per environment resource group (USD)."
    },
    "workloads": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?!(src|data|tests|mlops|infra|bootstrap|docs|rag|workloads)$)[a-z][a-z0-9-]{1,14}[a-z0-9]$" },
      "description": "Optional list of workload names sharing the one platform (one workspace per environment). Each gets workloads/<name>/ (src, mlops, data, tests) and its own ml-train and ml-deploy pipelines. Omit for a single workload at the repo root."
    },
    "use_private_networking": {
      "type": "boolean",
      "default": false,
      "description": "GitHub only; not allowed with cicd azdo. Deploy self-hosted Azure Container Instances runners in a VNet (AVM cicd-agents-and-runners) and put the Terraform state storage behind a private endpoint with public access disabled. runner_label then defaults to self-hosted and must not be a GitHub-hosted label such as ubuntu-latest."
    },
    "runners_vnet_address_space": {
      "type": "string",
      "default": "10.250.0.0/24",
      "description": "Address space of the runner VNet when use_private_networking is true."
    },
    "runner_label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "default": "ubuntu-latest",
      "description": "GitHub runs-on label for the generated workflows. With use_private_networking it must be a self-hosted label. Use a self-hosted label (for example an ARC scale set on a private AKS cluster) when the Terraform state storage or workspace has no public access."
    },
    "approvers": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "GitHub usernames required to approve deployments to every environment except dev (GitHub environment protection)."
    },
    "alert_emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "default": [],
      "description": "governance: budget alert recipients."
    },
    "existing_platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subnet_id",
        "log_analytics_workspace_id"
      ],
      "properties": {
        "subnet_id": {
          "type": "string"
        },
        "log_analytics_workspace_id": {
          "type": "string"
        },
        "private_dns_zone_ids": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blob": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "vault": {
              "type": "string"
            },
            "acr": {
              "type": "string"
            },
            "aml_api": {
              "type": "string"
            },
            "aml_notebooks": {
              "type": "string"
            }
          }
        }
      },
      "description": "existing-platform: resource IDs from the platform landing zone."
    },
    "rag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chat_model": { "type": "string", "default": "gpt-5.4-mini" },
        "chat_model_version": { "type": "string", "default": "2026-03-17" },
        "chat_capacity": { "type": "integer", "minimum": 1, "default": 10, "description": "Thousands of tokens per minute (GlobalStandard)." },
        "embedding_model": { "type": "string", "default": "text-embedding-3-small" },
        "embedding_model_version": { "type": "string", "default": "1" },
        "embedding_capacity": { "type": "integer", "minimum": 1, "default": 10, "description": "Thousands of tokens per minute (GlobalStandard)." },
        "search_sku": { "type": "string", "enum": ["free", "basic", "standard", "standard2", "standard3"], "default": "basic" },
        "search_location": { "type": "string", "description": "Azure region for Azure AI Search. Defaults to the main location. Set it when the main region is out of Search capacity." },
        "min_groundedness": { "type": "number", "minimum": 1, "maximum": 5, "default": 3.5, "description": "Evaluation quality gate: the pipeline fails below this average groundedness score." }
      },
      "description": "rag-llmops: model deployments, Azure AI Search tier and the evaluation gate. Check regional model quota first."
    },
    "adls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_name",
        "container",
        "path"
      ],
      "properties": {
        "account_name": {
          "type": "string",
          "pattern": "^[a-z0-9]{3,24}$"
        },
        "container": {
          "type": "string",
          "minLength": 3
        },
        "path": {
          "type": "string",
          "pattern": "^[^/].*\\.csv$",
          "description": "Path to a CSV inside the container, with the same columns as the taxi sample."
        }
      },
      "description": "Required when data_source is adls."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cicd": {
            "const": "github"
          }
        }
      },
      "then": {
        "required": [
          "github_org",
          "github_repo"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cicd": {
            "const": "azdo"
          }
        }
      },
      "then": {
        "required": [
          "azdo_org_url",
          "azdo_project"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "existing-platform"
          }
        }
      },
      "then": {
        "required": [
          "existing_platform"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "data_source": {
            "const": "adls"
          }
        },
        "required": [
          "data_source"
        ]
      },
      "then": {
        "required": [
          "adls"
        ]
      }
    },
    { "if": { "properties": { "scenario": { "const": "rag-llmops" } }, "required": ["scenario"] }, "else": { "not": { "required": ["rag"] } } },
    { "if": { "properties": { "scenario": { "const": "existing-platform" } }, "required": ["scenario"] }, "else": { "not": { "required": ["existing_platform"] } } },
    { "if": { "properties": { "data_source": { "const": "adls" } }, "required": ["data_source"] }, "else": { "not": { "required": ["adls"] } } },
    { "if": { "properties": { "cicd": { "const": "azdo" } }, "required": ["cicd"] }, "then": { "properties": { "use_private_networking": { "const": false } } } },
    {
      "if": { "properties": { "use_private_networking": { "const": true } }, "required": ["use_private_networking"] },
      "then": { "properties": { "runner_label": { "not": { "pattern": "^(ubuntu|windows|macos)-|-latest$" } } } }
    }
  ]
}
