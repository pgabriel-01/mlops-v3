{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MLOps v3 accelerator inputs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_name",
    "location",
    "subscription_id",
    "tenant_id",
    "iac",
    "cicd",
    "scenario"
  ],
  "properties": {
    "project_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,9}$",
      "description": "3-10 lowercase alphanumerics; used in CAF-style resource names (storage account limit is 24 chars)."
    },
    "location": {
      "type": "string",
      "pattern": "^[a-z0-9]+$",
      "description": "Azure region, e.g. eastus2."
    },
    "subscription_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$"
    },
    "iac": {
      "type": "string",
      "enum": [
        "terraform",
        "bicep"
      ]
    },
    "cicd": {
      "type": "string",
      "enum": [
        "github",
        "azdo"
      ]
    },
    "scenario": {
      "type": "string",
      "enum": [
        "basic-public",
        "managed-vnet-internet",
        "managed-vnet-approved",
        "byo-vnet",
        "batch-scoring",
        "online-bluegreen",
        "feature-store",
        "registry-promotion",
        "governance",
        "genai-foundry",
        "existing-platform"
      ],
      "description": "AML platform scenario (see Get-MLOpsScenario)."
    },
    "data_source": {
      "type": "string",
      "enum": [
        "taxi-csv",
        "adls"
      ],
      "default": "taxi-csv",
      "description": "taxi-csv uses the bundled sample. adls reads a CSV from an ADLS Gen2 container through an identity-based AML datastore. Parquet and other sources are planned (see docs/data-sources.md)."
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "dev",
          "test",
          "prod"
        ]
      },
      "default": [
        "dev",
        "test",
        "prod"
      ]
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "github_org": {
      "type": "string",
      "minLength": 1
    },
    "github_repo": {
      "type": "string",
      "minLength": 1
    },
    "azdo_org_url": {
      "type": "string",
      "pattern": "^https://dev\\.azure\\.com/[^/]+/?$"
    },
    "azdo_project": {
      "type": "string",
      "minLength": 1
    },
    "workload": {
      "type": "string",
      "enum": [
        "tabular"
      ],
      "default": "tabular",
      "description": "ML workload pack. nlp and vision are planned."
    },
    "vnet_address_space": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+/\\d+$",
      "default": "10.20.0.0/16",
      "description": "byo-vnet: address space of the created spoke VNet."
    },
    "allowed_outbound_fqdns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "pypi.org",
        "files.pythonhosted.org",
        "*.anaconda.com",
        "conda.anaconda.org"
      ],
      "description": "managed-vnet-approved: FQDN allow-list."
    },
    "budget_amount": {
      "type": "number",
      "minimum": 1,
      "default": 500,
      "description": "governance: monthly budget per environment resource group (USD)."
    },
    "alert_emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "default": [],
      "description": "governance: budget alert recipients."
    },
    "existing_platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subnet_id",
        "log_analytics_workspace_id"
      ],
      "properties": {
        "subnet_id": {
          "type": "string"
        },
        "log_analytics_workspace_id": {
          "type": "string"
        },
        "private_dns_zone_ids": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blob": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "vault": {
              "type": "string"
            },
            "acr": {
              "type": "string"
            },
            "aml_api": {
              "type": "string"
            },
            "aml_notebooks": {
              "type": "string"
            }
          }
        }
      },
      "description": "existing-platform: resource IDs from the platform landing zone."
    },
    "adls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_name",
        "container",
        "path"
      ],
      "properties": {
        "account_name": {
          "type": "string",
          "pattern": "^[a-z0-9]{3,24}$"
        },
        "container": {
          "type": "string",
          "minLength": 3
        },
        "path": {
          "type": "string",
          "pattern": "^[^/].*\\.csv$",
          "description": "Path to a CSV inside the container, with the same columns as the taxi sample."
        }
      },
      "description": "Required when data_source is adls."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cicd": {
            "const": "github"
          }
        }
      },
      "then": {
        "required": [
          "github_org",
          "github_repo"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "cicd": {
            "const": "azdo"
          }
        }
      },
      "then": {
        "required": [
          "azdo_org_url",
          "azdo_project"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "existing-platform"
          }
        }
      },
      "then": {
        "required": [
          "existing_platform"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "data_source": {
            "const": "adls"
          }
        },
        "required": [
          "data_source"
        ]
      },
      "then": {
        "required": [
          "adls"
        ]
      }
    }
  ]
}
