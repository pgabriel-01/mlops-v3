{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MLOps v3 accelerator inputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_name", "location", "subscription_id", "tenant_id", "iac", "cicd", "scenario"],
  "properties": {
    "project_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,9}$",
      "description": "3-10 lowercase alphanumerics; used in CAF-style resource names (storage account limit is 24 chars)."
    },
    "location": { "type": "string", "pattern": "^[a-z0-9]+$", "description": "Azure region, e.g. eastus2." },
    "subscription_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$" },
    "tenant_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$" },
    "iac": { "type": "string", "enum": ["terraform", "bicep"] },
    "cicd": { "type": "string", "enum": ["github", "azdo"] },
    "scenario": { "type": "string", "enum": ["tabular"], "description": "nlp and vision are planned scenario packs." },
    "data_source": { "type": "string", "enum": ["taxi-csv"], "default": "taxi-csv", "description": "transactions-parquet (MS Learn feature store sample) is planned for the next phase." },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["dev", "test", "prod"] },
      "default": ["dev", "prod"]
    },
    "private_networking": { "type": "boolean", "default": false },
    "feature_store": { "type": "boolean", "default": false },
    "tags": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "default": {}
    },
    "github_org": { "type": "string", "minLength": 1 },
    "github_repo": { "type": "string", "minLength": 1 },
    "azdo_org_url": { "type": "string", "pattern": "^https://dev\\.azure\\.com/[^/]+/?$" },
    "azdo_project": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "cicd": { "const": "github" } } },
      "then": { "required": ["github_org", "github_repo"] }
    },
    {
      "if": { "properties": { "cicd": { "const": "azdo" } } },
      "then": { "required": ["azdo_org_url", "azdo_project"] }
    }
  ]
}
